# Person A's targets. Person B has Makefile.chat. No shared Makefile, so no conflicts.
#
#   make -f Makefile.data help

SHELL := /bin/bash
PG    := postgresql://postgres:$${POSTGRES_PASSWORD:-devonly}@localhost:5432/status_clock
CH    := clickhouse client --host localhost --password $${CLICKHOUSE_PASSWORD:-devonly}

.PHONY: help deps up down migrate seed reseed ch-ddl ch-user cloud cloud-verify fetch convert load corpus quality replicate reset-evals test itest api verify reset demo

help:
	@grep -E '^[a-z-]+:.*?##' $(MAKEFILE_LIST) | sed 's/:.*##/\t/' | column -t -s $$'\t'

deps:          ## install python dependencies
	python -m pip install -r requirements.txt

up:            ## start postgres + clickhouse
	docker compose -f infra/data.compose.yml up -d --wait

down:          ## stop them
	docker compose -f infra/data.compose.yml down

migrate:       ## apply Postgres migrations in order
	@for f in db/migrations/*.sql; do echo "== $$f"; psql "$(PG)" -v ON_ERROR_STOP=1 -f "$$f" || exit 1; done

seed:          ## seed rule param shapes and rules
	@for f in db/seeds/*.sql; do echo "== $$f"; psql "$(PG)" -v ON_ERROR_STOP=1 -f "$$f" || exit 1; done

reseed:        ## reset the demo personas. Run between judges.
	@psql "$(PG)" -v ON_ERROR_STOP=1 -q -f db/seeds/030_personas.sql
	@echo "personas reset: Maria employed, Daniel employed, no extra facts"

ch-ddl:        ## apply ClickHouse DDL. ORDER MATTERS: views before data. REVIEW A5.
	@for f in clickhouse/ddl/0[0-8]*.sql; do echo "== $$f"; $(CH) --multiquery < "$$f" || exit 1; done
	@$(MAKE) -f Makefile.data ch-user

ch-user:       ## create the read-only ClickHouse user the LibreChat MCP connects as
	@# 090 is applied separately because it carries a password placeholder. It needs
	@# CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1 on the server, which infra/data.compose.yml
	@# sets; without it the default user has no CREATE USER grant and the only way to
	@# give the agent ClickHouse access is to hand it admin credentials.
	@sed 's/{{CH_READONLY_PASSWORD}}/$(or $(CH_READONLY_PASSWORD),devonly-readonly)/' \
	  clickhouse/ddl/090_readonly_user.sql | $(CH) --multiquery
	@echo "chat_readonly ready. Hand Person B: CH_READONLY_PASSWORD=$(or $(CH_READONLY_PASSWORD),devonly-readonly)"

FY ?= 2025
DOL := https://www.dol.gov/sites/dolgov/files/ETA/oflc/pdfs
LCA := LCA_Disclosure_Data_FY$(FY)_Q4

fetch:         ## download one LCA disclosure file. FY=2025 by default.
	@mkdir -p data
	curl -fSL -o data/$(LCA).xlsx $(DOL)/$(LCA).xlsx
	python -m ingest.headers data/$(LCA).xlsx | tail -5

convert:       ## xlsx -> csv, once. FY=2025 by default.
	python -m ingest.convert data/$(LCA).xlsx

load:          ## load one converted file. Needs ch-ddl first. FY=2025 by default.
	python -m ingest.load --fiscal-year $(FY) --dry-run data/$(LCA).csv
	python -m ingest.load --fiscal-year $(FY) data/$(LCA).csv

corpus:        ## fetch + convert + load two fiscal years, then gate
	$(MAKE) -f Makefile.data fetch convert load FY=2024
	$(MAKE) -f Makefile.data fetch convert load FY=2025
	$(MAKE) -f Makefile.data quality

cloud:         ## push schema + real corpus to ClickHouse Cloud (needs infra/.env.cloud)
	@set -a; . infra/.env.cloud; set +a; python clickhouse/cloud/migrate.py

cloud-verify:  ## run the product's own corpus query against Cloud, not against local
	@set -a; . infra/.env.cloud; set +a; \
	  CLICKHOUSE_HOST=$$CH_CLOUD_HOST CLICKHOUSE_PORT=8443 CLICKHOUSE_USER=default \
	  CLICKHOUSE_PASSWORD=$$CH_CLOUD_PASSWORD \
	  python -c "$$CLOUD_VERIFY_PY"

replicate:     ## drain the Postgres outbox into ClickHouse (the CDC path)
	python -m api.replicate

reset-evals:   ## rebuild clock_evaluations AND its rollup from the outbox
	@# Truncating clock_evaluations alone leaves risk_rollup holding rows whose
	@# users no longer exist. A materialized view's data lives in its own table.
	$(CH) --query "TRUNCATE TABLE clock_evaluations"
	$(CH) --query "TRUNCATE TABLE risk_rollup"
	psql "$(PG)" -q -c "UPDATE clock_evaluation_outbox SET replicated_at = NULL"
	python -m api.replicate

quality:       ## data quality gates. Must pass before trusting any corpus query.
	$(CH) --multiquery < clickhouse/queries/data_quality.sql

test:          ## engine unit tests. No database required.
	python -m pytest engine/tests -q

itest:         ## API integration tests. Needs 'up migrate seed'.
	python -m pytest api/tests -q

demo:          ## print both personas' computed clocks straight from the API
	@python -c "$$DEMO_PY"

api:           ## run the API
	uvicorn api.main:app --reload --port 8000

verify:        ## engine + API + contract. Needs 'up migrate seed'.
	python -m pytest engine/tests api/tests -q
	python contracts/validate.py
	@echo
	@echo "Still unverified after this:"
	@echo "  - the outbox is never drained to ClickHouse"
	@echo "  - the population replay has never run on volume"
	@echo "  - PERM, the visa bulletin and soc_embeddings are empty"
	@echo "  - no alerts are generated or delivered"
	@echo "  - no rule has been checked against its primary source"
	@echo "See TRACK_DATA.md for the full list."

reset:         ## destroy local data and start over
	docker compose -f infra/data.compose.yml down -v
	rm -rf infra/pgdata infra/clickhouse-data

define DEMO_PY
import sys; sys.path.insert(0, ".")
from fastapi.testclient import TestClient
from api.main import app
c = TestClient(app)
for sess in ("sess_maria", "sess_daniel"):
    b = c.get("/v1/clocks", cookies={"sc_session": sess}, params={"as_of": "2026-08-28"}).json()
    print("\n== " + sess + "  as_of=" + b["as_of"] + "  needs_attention=" + str(b["needs_attention"]))
    for k in b["clocks"]:
        if not k["applicable"]:
            print("   [not running] %-20s %s" % (k["clock_key"], k["not_applicable_reason"])); continue
        p = k["provenance"]
        print("   [%-8s] %s  remaining=%s" % (k["severity"], k["label"], k["days_remaining"]))
        if k.get("superseded"):
            print("        struck %s  delta=+%sd" % (k["superseded"]["prior_value"], k["superseded"]["delta_days"]))
        print("        %s | eff. %s | verified=%s" % (p["citation"], p["effective_from"], p["verified"]))
endef
export DEMO_PY

define CLOUD_VERIFY_PY
import sys; sys.path.insert(0, ".")
from api import clickhouse as ch
from api.main import PERCENTILE_SQL, PERM_SQL, _sql
p = {"soc":"15-1252","state":"CA","wage":188000,"fy":2025}
r, ms = ch.query(_sql(PERCENTILE_SQL), p)
print("  %s CA $188,000 FY2025" % r[0]["soc_title"])
print("    percentile %s of n=%s  (%sms over TLS)" % (r[0]["percentile"], format(r[0]["n_filings"], ","), ms))
pm, _ = ch.query(_sql(PERM_SQL))
print("    PERM median %sd over %s filings" % (pm[0]["median_days"], format(pm[0]["n"], ",")))
endef
export CLOUD_VERIFY_PY
