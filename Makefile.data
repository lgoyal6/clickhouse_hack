# Person A's targets. Person B has Makefile.chat. No shared Makefile, so no conflicts.
#
#   make -f Makefile.data help

SHELL := /bin/bash
PG    := postgresql://postgres:$${POSTGRES_PASSWORD:-devonly}@localhost:5432/status_clock
CH    := clickhouse client --host localhost --password $${CLICKHOUSE_PASSWORD:-devonly}

.PHONY: help deps up down migrate seed ch-ddl fetch convert load corpus quality test itest api verify reset demo

help:
	@grep -E '^[a-z-]+:.*?##' $(MAKEFILE_LIST) | sed 's/:.*##/\t/' | column -t -s $$'\t'

deps:          ## install python dependencies
	python -m pip install -r requirements.txt

up:            ## start postgres + clickhouse
	docker compose -f infra/data.compose.yml up -d --wait

down:          ## stop them
	docker compose -f infra/data.compose.yml down

migrate:       ## apply Postgres migrations in order
	@for f in db/migrations/*.sql; do echo "== $$f"; psql "$(PG)" -v ON_ERROR_STOP=1 -f "$$f" || exit 1; done

seed:          ## seed rule param shapes and rules
	@for f in db/seeds/*.sql; do echo "== $$f"; psql "$(PG)" -v ON_ERROR_STOP=1 -f "$$f" || exit 1; done

ch-ddl:        ## apply ClickHouse DDL. ORDER MATTERS: views before data. REVIEW A5.
	@for f in clickhouse/ddl/0*.sql; do echo "== $$f"; $(CH) --multiquery < "$$f" || exit 1; done

FY ?= 2025
DOL := https://www.dol.gov/sites/dolgov/files/ETA/oflc/pdfs
LCA := LCA_Disclosure_Data_FY$(FY)_Q4

fetch:         ## download one LCA disclosure file. FY=2025 by default.
	@mkdir -p data
	curl -fSL -o data/$(LCA).xlsx $(DOL)/$(LCA).xlsx
	python -m ingest.headers data/$(LCA).xlsx | tail -5

convert:       ## xlsx -> csv, once. FY=2025 by default.
	python -m ingest.convert data/$(LCA).xlsx

load:          ## load one converted file. Needs ch-ddl first. FY=2025 by default.
	python -m ingest.load --fiscal-year $(FY) --dry-run data/$(LCA).csv
	python -m ingest.load --fiscal-year $(FY) data/$(LCA).csv

corpus:        ## fetch + convert + load two fiscal years, then gate
	$(MAKE) -f Makefile.data fetch convert load FY=2024
	$(MAKE) -f Makefile.data fetch convert load FY=2025
	$(MAKE) -f Makefile.data quality

quality:       ## data quality gates. Must pass before trusting any corpus query.
	$(CH) --multiquery < clickhouse/queries/data_quality.sql

test:          ## engine unit tests. No database required.
	python -m pytest engine/tests -q

itest:         ## API integration tests. Needs 'up migrate seed'.
	python -m pytest api/tests -q

demo:          ## print both personas' computed clocks straight from the API
	@python -c "$$DEMO_PY"

api:           ## run the API
	uvicorn api.main:app --reload --port 8000

verify:        ## engine + API + contract. Needs 'up migrate seed'.
	python -m pytest engine/tests api/tests -q
	python contracts/validate.py
	@echo
	@echo "Still unverified after this: no real OFLC file has been loaded, so the"
	@echo "column maps in ingest/column_maps.py are still guesses, and no rule has"
	@echo "been checked against its primary source."

reset:         ## destroy local data and start over
	docker compose -f infra/data.compose.yml down -v
	rm -rf infra/pgdata infra/clickhouse-data

define DEMO_PY
import sys; sys.path.insert(0, ".")
from fastapi.testclient import TestClient
from api.main import app
c = TestClient(app)
for sess in ("sess_maria", "sess_daniel"):
    b = c.get("/v1/clocks", cookies={"sc_session": sess}, params={"as_of": "2026-08-28"}).json()
    print("\n== " + sess + "  as_of=" + b["as_of"] + "  needs_attention=" + str(b["needs_attention"]))
    for k in b["clocks"]:
        if not k["applicable"]:
            print("   [not running] %-20s %s" % (k["clock_key"], k["not_applicable_reason"])); continue
        p = k["provenance"]
        print("   [%-8s] %s  remaining=%s" % (k["severity"], k["label"], k["days_remaining"]))
        if k.get("superseded"):
            print("        struck %s  delta=+%sd" % (k["superseded"]["prior_value"], k["superseded"]["delta_days"]))
        print("        %s | eff. %s | verified=%s" % (p["citation"], p["effective_from"], p["verified"]))
endef
export DEMO_PY
